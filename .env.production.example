# ==============================================================================
# TestPilot Platform — Production Free-Tier Cloud Template
# Stack: Vercel (Web) + Render/Fly.io (API) + Supabase (DB/Storage) + Upstash (Redis)
# ==============================================================================

NODE_ENV=production
PORT=4000
LOG_LEVEL=info
APP_BASE_URL=https://testpilot.yourdomain.com
CORS_ORIGIN=https://testpilot.yourdomain.com,https://your-app.vercel.app

# Web <-> API (HTTPS endpoints with automatic SSL)
NEXT_PUBLIC_API_URL=https://api.testpilot.yourdomain.com/api/v1
INTERNAL_API_URL=https://api.testpilot.yourdomain.com/api/v1

# Supabase PostgreSQL (Transaction Pooler :6543 + Direct :5432 for Prisma migrations)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Serverless Redis (TLS enabled via rediss://)
REDIS_URL="rediss://default:[UPSTASH_PASSWORD]@[ENDPOINT].upstash.io:6379"

# Supabase Storage (1GB Free Tier)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=[SUPABASE_SERVICE_ROLE_KEY]
SUPABASE_STORAGE_BUCKET=testpilot-artifacts

# Security (Generate with: openssl rand -hex 32)
CREDENTIAL_ENCRYPTION_KEY=[64_HEX_CHARACTER_AES256_KEY]

# Clerk Authentication (Production keys)
CLERK_SECRET_KEY=sk_live_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# OpenRouter LLM API (Free-tier models)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# GitHub App (Configure webhook URL to https://api.testpilot.yourdomain.com/api/v1/github/webhook)
GITHUB_APP_ID=
GITHUB_APP_SLUG=testpilot-ai-qa
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=https://api.testpilot.yourdomain.com/api/v1/github/webhook

# OpenTelemetry (Optional — set to false if no OTLP collector is attached)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=testpilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=
