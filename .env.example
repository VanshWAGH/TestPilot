# Environment & Ports
NODE_ENV=development
PORT=4000
WEB_PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Redis (Queues & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Storage (Free Supabase Storage - 1GB Free Tier / S3-compatible)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=testpilot-artifacts

# MinIO Local Storage (Optional Docker fallback)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_ARTIFACTS=testpilot-artifacts
S3_FORCE_PATH_STYLE=true

# Auth (Clerk)
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# OpenRouter / LLM API (Free Tier Models)
# Note: OpenRouter is a unified router. A single OpenRouter key gives access to ALL models
# (Meta Llama, Google Gemini, Qwen, DeepSeek, Mistral, etc.) without needing separate provider accounts.
# For multiple keys/accounts (to bypass 20 req/min free-tier rate limits with auto-rotation):
# OPENROUTER_API_KEYS="sk-or-v1-key1...,sk-or-v1-key2..."
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# GitHub Integration (Phase 2+)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
