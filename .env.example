# ==============================================================================
# TestPilot Platform — Environment Configuration (Development Example)
# ==============================================================================

# Environment & Ports
NODE_ENV=development
PORT=4000
WEB_PORT=3000
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Web <-> API URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
INTERNAL_API_URL=http://localhost:4000/api/v1

# Database (PostgreSQL / Supabase Free Tier)
DATABASE_URL="postgresql://testpilot:testpilot_password@localhost:5432/testpilot_db?schema=public"
DIRECT_URL="postgresql://testpilot:testpilot_password@localhost:5432/testpilot_db?schema=public"

# Redis (Local Docker or Upstash Free Tier rediss:// URL)
# REDIS_URL="rediss://default:your_password@your-upstash-endpoint.upstash.io:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

# Storage (Free Supabase Storage - 1GB Free Tier / S3-compatible)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=testpilot-artifacts

# MinIO Local Storage (Optional Docker fallback)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET_ARTIFACTS=testpilot-artifacts
S3_FORCE_PATH_STYLE=true

# Security (AES-256-GCM Encryption Key - 32+ chars / 64 hex chars)
CREDENTIAL_ENCRYPTION_KEY=change-this-32-byte-hex-key-for-local-development-only

# Auth (Clerk Free Tier)
CLERK_SECRET_KEY=your_clerk_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here

# OpenRouter / LLM API (Free Tier Models)
# Multiple keys comma-separated for automatic rotation:
# OPENROUTER_API_KEYS="sk-or-v1-key1...,sk-or-v1-key2..."
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# GitHub App Integration (No PATs in production)
GITHUB_APP_ID=
GITHUB_APP_SLUG=testpilot-ai-qa
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Optional Jira Integration
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Observability (OpenTelemetry)
OTEL_ENABLED=true
OTEL_SERVICE_NAME=testpilot-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
